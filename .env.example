# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://puerto:puerto@localhost:5432/puerto_rico

# Express
PORT=3001
NODE_ENV=development
# Generate with `openssl rand -hex 32`. The value below is rejected at boot.
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CLIENT_ORIGIN=http://localhost:5173

# Google Identity Services (ID token). Same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# GitHub OAuth App. Callback must go through the Vite /api proxy in dev
# so the session cookie is set on the SPA origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=
